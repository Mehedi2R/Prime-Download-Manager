{
  "manifest_version": 3,
  "name": "PDM Extension",
  "version": "3.0.46",
  "description": "High-Speed PDM Extension for Chrome, Brave, Edge, Firefox, and Opera with Turbo Multi-Socket Download Acceleration and Video Sniffer.",
  "permissions": [
    "downloads",
    "tabs",
    "activeTab",
    "storage",
    "contextMenus",
    "cookies",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["floating_button.css"],
      "all_frames": true,
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*"],
      "js": ["yt_page_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Prime Download Manager Extension - Add Download",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "prime-downloader@kcr.app",
      "strict_min_version": "109.0"
    }
  }
}
