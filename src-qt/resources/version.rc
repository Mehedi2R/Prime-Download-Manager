#include <windows.h>

IDI_ICON1 ICON "icons/app_logo.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,0,46,0
PRODUCTVERSION  3,0,46,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PrimeApps\0"
            VALUE "FileDescription",  "Prime Download Manager\0"
            VALUE "FileVersion",      "3.0.46.0\0"
            VALUE "InternalName",     "PrimeDownloadManager.exe\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 PrimeApps. All rights reserved.\0"
            VALUE "OriginalFilename", "PrimeDownloadManager.exe\0"
            VALUE "ProductName",      "Prime Download Manager\0"
            VALUE "ProductVersion",   "3.0.46\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
